# Optional OpenID Connect sign-in. Copy these values into env.backend.
# Register the callbacks exactly as shown:
# Google:    http://localhost:4000/auth/google/callback
# Microsoft: http://localhost:4000/auth/microsoft/callback
SSO_FRONTEND_URL=http://localhost:3000
SSO_BACKEND_URL=http://localhost:4000
SSO_ALLOWED_DOMAINS=
SSO_AUTO_PROVISION=false

# Required only when SSO_AUTO_PROVISION=true; use an active role_id from the DB.
# SSO_DEFAULT_ROLE_ID=3

# Set each provider's values together to enable that provider.
# GOOGLE_CLIENT_ID=your-google-oauth-client-id
# GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# MICROSOFT_CLIENT_ID=your-entra-application-client-id
# MICROSOFT_CLIENT_SECRET=your-entra-client-secret
# MICROSOFT_TENANT_ID=00000000-0000-4000-8000-000000000000
